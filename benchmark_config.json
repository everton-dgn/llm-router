{
  "purpose": "offline quality benchmark executors only",
  "routes": [
    {
      "name": "claude",
      "display_name": "Claude Opus 4.8 (dynamic effort)",
      "headless": {
        "env": {
          "CLAUDE_CONFIG_DIR": "${HOME}/.claude"
        },
        "worker": {
          "effort_policy": "claude_dynamic",
          "argv": [
            "claude",
            "--print",
            "--output-format",
            "json",
            "--no-session-persistence",
            "--append-system-prompt-file",
            "${HOME}/.claude/system-prompt/append.md",
            "--dangerously-skip-permissions",
            "--model",
            "claude-opus-4-8",
            "--effort",
            "{effort}"
          ],
          "output_format": "claude_json",
          "timeout_seconds": 900
        },
        "judge": {
          "argv": [
            "claude",
            "--print",
            "--output-format",
            "json",
            "--no-session-persistence",
            "--tools",
            "",
            "--model",
            "claude-opus-4-8",
            "--effort",
            "xhigh"
          ],
          "output_format": "claude_json",
          "timeout_seconds": 300
        }
      }
    },
    {
      "name": "codex",
      "display_name": "GPT-5.6 Sol (xhigh)",
      "headless": {
        "env": {},
        "worker": {
          "argv": [
            "codex",
            "--ask-for-approval",
            "never",
            "exec",
            "--json",
            "--ephemeral",
            "--output-last-message",
            "{output_file}",
            "--model",
            "gpt-5.6-sol",
            "--config",
            "model_reasoning_effort=xhigh",
            "--config",
            "features.apps=false",
            "--sandbox",
            "workspace-write",
            "--cd",
            "{cwd}",
            "-"
          ],
          "output_format": "codex_last_message",
          "timeout_seconds": 900
        },
        "judge": {
          "argv": [
            "codex",
            "--ask-for-approval",
            "never",
            "exec",
            "--json",
            "--ephemeral",
            "--output-last-message",
            "{output_file}",
            "--model",
            "gpt-5.6-sol",
            "--config",
            "model_reasoning_effort=xhigh",
            "--config",
            "features.apps=false",
            "--sandbox",
            "read-only",
            "--cd",
            "{cwd}",
            "-"
          ],
          "output_format": "codex_last_message",
          "timeout_seconds": 300
        }
      }
    },
    {
      "name": "minimax",
      "display_name": "MiniMax M3",
      "headless": {
        "env": {
          "DISABLE_COMPACT": "1",
          "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
          "ANTHROPIC_BASE_URL": "https://api.minimax.io/anthropic",
          "ANTHROPIC_AUTH_TOKEN": {
            "from_env": "MINIMAX_API_KEY"
          },
          "ANTHROPIC_API_KEY": "",
          "API_TIMEOUT_MS": "3000000",
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
          "ANTHROPIC_DEFAULT_OPUS_MODEL": "MiniMax-M3",
          "ANTHROPIC_DEFAULT_SONNET_MODEL": "MiniMax-M3",
          "ANTHROPIC_DEFAULT_HAIKU_MODEL": "MiniMax-M3",
          "ANTHROPIC_MODEL": "MiniMax-M3",
          "ANTHROPIC_SMALL_FAST_MODEL": "MiniMax-M3",
          "CLAUDE_CODE_SUBAGENT_MODEL": "MiniMax-M3",
          "CLAUDE_CONFIG_DIR": "${HOME}/.claude-openrouter"
        },
        "worker": {
          "argv": [
            "claude",
            "--print",
            "--output-format",
            "json",
            "--no-session-persistence",
            "--append-system-prompt-file",
            "${HOME}/.claude/system-prompt/append.md",
            "--permission-mode",
            "dontAsk",
            "--tools",
            "Read,Glob,Grep",
            "--strict-mcp-config",
            "--mcp-config",
            "{\"mcpServers\":{}}",
            "--disable-slash-commands",
            "--model",
            "MiniMax-M3"
          ],
          "output_format": "claude_json",
          "timeout_seconds": 900
        },
        "judge": {
          "argv": [
            "claude",
            "--print",
            "--output-format",
            "json",
            "--no-session-persistence",
            "--tools",
            "",
            "--strict-mcp-config",
            "--mcp-config",
            "{\"mcpServers\":{}}",
            "--disable-slash-commands",
            "--model",
            "MiniMax-M3"
          ],
          "output_format": "claude_json",
          "timeout_seconds": 300
        }
      }
    },
    {
      "name": "glm",
      "display_name": "GLM 5.2",
      "headless": {
        "env": {
          "DISABLE_COMPACT": "1",
          "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
          "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
          "ANTHROPIC_AUTH_TOKEN": {
            "from_env": "ZAI_API_KEY"
          },
          "ANTHROPIC_API_KEY": "",
          "API_TIMEOUT_MS": "3000000",
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
          "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.2",
          "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.2",
          "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.7",
          "ANTHROPIC_MODEL": "glm-5.2",
          "ANTHROPIC_SMALL_FAST_MODEL": "glm-4.7",
          "CLAUDE_CODE_SUBAGENT_MODEL": "glm-5.2",
          "CLAUDE_CONFIG_DIR": "${HOME}/.claude-openrouter"
        },
        "worker": {
          "argv": [
            "claude",
            "--print",
            "--output-format",
            "json",
            "--no-session-persistence",
            "--append-system-prompt-file",
            "${HOME}/.claude/system-prompt/append.md",
            "--dangerously-skip-permissions",
            "--model",
            "glm-5.2"
          ],
          "output_format": "claude_json",
          "timeout_seconds": 900
        },
        "judge": {
          "argv": [
            "claude",
            "--print",
            "--output-format",
            "json",
            "--no-session-persistence",
            "--tools",
            "",
            "--model",
            "glm-5.2"
          ],
          "output_format": "claude_json",
          "timeout_seconds": 300
        }
      }
    }
  ]
}
