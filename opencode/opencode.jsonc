{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "zai-coding-plan/glm-5.2",
  "default_agent": "router",
  "subagent_depth": 1,
  "disabled_providers": ["github-copilot", "opencode-go"],
  "provider": {
    "minimax-coding-plan": {
      "name": "MiniMax Coding Plan",
      "whitelist": ["MiniMax-M3"],
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}"
      }
    },
    "zai-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2"
        }
      }
    }
  },
  "agent": {
    "router": {
      "description": "Central router that classifies each workflow stage and delegates it to the configured model.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "textVerbosity": "medium",
      "steps": 24,
      "prompt": "You are the central orchestration agent. For every user request, call llm_route before doing substantive work. Never perform the delegated task yourself. Pass the user's original request to llm_route verbatim. Do not paraphrase, expand, translate, summarize, or add paths, output formats, item counts, criteria, constraints, or inferred requirements. Set the workflow stage only through llm_route's separate stage argument. For a single-stage request, use stage=request, except that a request whose deliverable is a review, audit, threat model, or security analysis must use stage=review. Follow the returned target exactly. Invoke minimax, glm, codex, or codex-reviewer through delegate_task; invoke claude through claude_opus and pass the effort returned by llm_route exactly. After routing, build a self-contained request for the selected worker. Include the original user request verbatim and add only operational context required for that stage, such as the working directory, a completed plan, or validation evidence. Never broaden the deliverable or invent requirements. For work that explicitly requests planning followed by execution, or that changes architecture, a public contract, security-sensitive behavior, or five or more files, coordinate separate stages in this order: plan, execute, review. Call llm_route separately for each stage with the same verbatim original request and the appropriate stage argument. Pass the completed plan output into the execution worker request only after routing. Use codex-reviewer for the review stage. If review finds a concrete defect, allow one correction through the routed executor and one final review, then stop. Keep control in this parent session. Do not let workers route or delegate. Preserve the user's language, constraints, and requested output format. In the final response, state which model handled each completed stage.",
      "permission": {
        "*": "deny",
        "llm_route": "allow",
        "delegate_task": "allow",
        "claude_opus": "allow",
        "task": "deny",
        "question": "allow"
      }
    },
    "minimax": {
      "description": "MiniMax M3 worker for literal, low-risk, read-only counting, listing, locating, extraction, and exact formatting.",
      "mode": "all",
      "model": "minimax-coding-plan/MiniMax-M3",
      "steps": 8,
      "prompt": "Perform only the delegated literal read-only task. Use repository evidence and return exact findings. Do not summarize, translate, rewrite, brainstorm, review, edit files, run project code, or broaden the scope. Include file paths or the material command result when applicable.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch --show-current*": "allow",
          "git ls-files*": "allow",
          "git -C * ls-files*": "allow",
          "ls*": "allow",
          "tree*": "allow",
          "fd*": "allow",
          "find*": "allow",
          "rg*": "allow",
          "grep*": "allow",
          "wc*": "allow"
        }
      }
    },
    "glm": {
      "description": "GLM 5.2 worker for translation and simple or intermediate implementation, debugging, refactoring, tests, documentation, and contained content work.",
      "mode": "all",
      "model": "zai-coding-plan/glm-5.2",
      "steps": 24,
      "prompt": "Handle the delegated simple or intermediate task completely. Inspect relevant sources before changing code, preserve the requested language and format, keep edits scoped, and run focused validation after edits. Do not delegate or change the routing decision.",
      "permission": {
        "*": "allow",
        "task": "deny",
        "llm_route": "deny",
        "delegate_task": "deny",
        "claude_opus": "deny",
        "external_directory": "deny",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "rmdir *": "deny",
          "unlink *": "deny",
          "trash *": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "docker *": "deny",
          "kubectl *": "deny",
          "vercel *": "deny",
          "brew install*": "deny",
          "npm install -g*": "deny",
          "npm install --global*": "deny",
          "pnpm add -g*": "deny",
          "pnpm add --global*": "deny"
        }
      }
    },
    "codex": {
      "description": "GPT-5.6 Sol xhigh worker for difficult engineering, deep debugging, hard refactoring, security work, and precise technical writing.",
      "mode": "all",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "steps": 32,
      "prompt": "Handle the delegated difficult engineering task completely. Inspect definitions, consumers, tests, and configuration before acting. Keep changes scoped, validate in proportion to risk, and report concrete evidence. Do not delegate or change the routing decision.",
      "permission": {
        "*": "allow",
        "task": "deny",
        "llm_route": "deny",
        "delegate_task": "deny",
        "claude_opus": "deny",
        "external_directory": "deny",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "rmdir *": "deny",
          "unlink *": "deny",
          "trash *": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "docker *": "deny",
          "kubectl *": "deny",
          "vercel *": "deny",
          "brew install*": "deny",
          "npm install -g*": "deny",
          "npm install --global*": "deny",
          "pnpm add -g*": "deny",
          "pnpm add --global*": "deny"
        }
      }
    },
    "codex-reviewer": {
      "description": "GPT-5.6 Sol xhigh read-only reviewer for code review, audit, security analysis, and verification of completed work.",
      "mode": "all",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "steps": 24,
      "prompt": "Review the delegated result without modifying files. Verify claims against code and tests. Report only actionable findings with severity, file and line, evidence, impact, and a concrete correction. If there are no findings, say so and list what was verified. Do not delegate.",
      "permission": {
        "*": "allow",
        "task": "deny",
        "llm_route": "deny",
        "delegate_task": "deny",
        "claude_opus": "deny",
        "edit": "deny",
        "external_directory": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "ls*": "allow",
          "tree*": "allow",
          "fd*": "allow",
          "find*": "allow",
          "rg*": "allow",
          "grep*": "allow"
        }
      }
    }
  }
}
