{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "ollama/hf.co/mradermacher/Plano-Orchestrator-4B-GGUF:Q4_K_M",
  "default_agent": "router-auto",
  "disabled_providers": ["github-copilot", "opencode-go"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "hf.co/mradermacher/Plano-Orchestrator-4B-GGUF:Q4_K_M": {
          "name": "Plano Orchestrator 4B"
        }
      }
    },
    "minimax-coding-plan": {
      "name": "MiniMax Coding Plan",
      "whitelist": ["MiniMax-M3"],
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}"
      }
    },
    "zai-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2"
        }
      }
    },
    "claude-agent": {
      "npm": "__CLAUDE_AGENT_PROVIDER_URL__",
      "name": "Claude Agent SDK",
      "options": {
        "claudePath": "__CLAUDE_CODE_PATH__"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "agent": {
    "router-auto": {
      "description": "Automatic local model selector. Each message is classified before a worker executes it.",
      "mode": "primary",
      "model": "ollama/hf.co/mradermacher/Plano-Orchestrator-4B-GGUF:Q4_K_M",
      "steps": 1,
      "prompt": "If this prompt reaches the model, report that the llm-router handoff plugin is unavailable. Do not execute the user's task.",
      "permission": {
        "*": "deny"
      }
    },
    "router-manual": {
      "description": "Fixed routing mode. The first classified worker is stored in session metadata and reused.",
      "mode": "primary",
      "model": "ollama/hf.co/mradermacher/Plano-Orchestrator-4B-GGUF:Q4_K_M",
      "steps": 1,
      "prompt": "If this prompt reaches the model, report that the llm-router handoff plugin is unavailable. Do not execute the user's task.",
      "permission": {
        "*": "deny"
      }
    },
    "minimax": {
      "description": "MiniMax M3 for literal, low-risk, read-only requests.",
      "mode": "subagent",
      "model": "minimax-coding-plan/MiniMax-M3",
      "steps": 8,
      "prompt": "Handle the user's current request directly. Stay read-only, preserve the exact requested format, and use repo_query when repository evidence is needed. Do not delegate or route again.",
      "permission": {
        "*": "deny",
        "repo_query": "allow"
      }
    },
    "glm": {
      "description": "GLM 5.2 for simple and intermediate work.",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5.2",
      "steps": 24,
      "prompt": "Handle the user's current request directly and completely. Inspect relevant sources before changing code, keep edits scoped, and run focused validation. Do not delegate or route again.",
      "permission": {
        "*": "allow",
        "task": "deny",
        "external_directory": "deny",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "rmdir *": "deny",
          "unlink *": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "docker *": "deny",
          "kubectl *": "deny",
          "vercel *": "deny",
          "brew install*": "deny",
          "npm install -g*": "deny",
          "npm install --global*": "deny",
          "pnpm add -g*": "deny",
          "pnpm add --global*": "deny"
        }
      }
    },
    "claude": {
      "description": "Claude Opus 4.8 through the local Claude Agent SDK with its native coding tools.",
      "mode": "subagent",
      "model": "claude-agent/claude-opus-4-8",
      "steps": 24,
      "prompt": "Handle the user's current request directly and completely. Use Claude Code tools as needed, inspect relevant sources before changing code, keep edits scoped, and run focused validation. Do not route to another model or wait for another coordinator.",
      "permission": {
        "*": "deny"
      }
    },
    "codex": {
      "description": "GPT-5.6 Sol xhigh for difficult engineering, review and security work.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "steps": 32,
      "prompt": "Handle the user's current request directly and completely. Inspect definitions, consumers, tests and configuration before acting. Keep changes scoped and validate in proportion to risk. For review requests, stay read-only and report only evidence-backed findings. Do not delegate or route again.",
      "permission": {
        "*": "allow",
        "task": "deny",
        "external_directory": "deny",
        "bash": {
          "*": "ask",
          "rm *": "deny",
          "rmdir *": "deny",
          "unlink *": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "docker *": "deny",
          "kubectl *": "deny",
          "vercel *": "deny",
          "brew install*": "deny",
          "npm install -g*": "deny",
          "npm install --global*": "deny",
          "pnpm add -g*": "deny",
          "pnpm add --global*": "deny"
        }
      }
    }
  }
}
