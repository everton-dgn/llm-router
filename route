#!/usr/bin/env bash
# Roteador local de modelos: um classificador local (definido em config.json; por
# padrao o Plano-Orchestrator-4B rodando no Ollama) decide qual modelo deve atender
# cada prompt e abre a CLI interativa dele numa janela do Ghostty.
#
# Toda a config (modelo, endpoint, rotas, criterios, mapeamento CLI, parametros)
# vive no config.json ao lado deste script. Editar rotas nao exige tocar no codigo.
#
# Uso:
#   route "prompt"          # dry-run: so mostra a rota escolhida
#   route --run "prompt"    # decide E abre a CLI interativa no Ghostty
#
# Requer: modelo do config baixado no Ollama (ex.):
#   ollama pull hf.co/mradermacher/Plano-Orchestrator-4B-GGUF:Q4_K_M
set -euo pipefail

RUN=false
if [[ "${1:-}" == "--run" ]]; then RUN=true; shift; fi
PROMPT="${1:-}"
[[ -z "$PROMPT" ]] && { echo "uso: $0 [--run] \"prompt\""; exit 1; }

# config.json ao lado do script (resolve mesmo chamado via PATH de outro diretorio).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$SCRIPT_DIR/config.json"
[[ -f "$CONFIG" ]] || { echo "erro: config nao encontrado em $CONFIG" >&2; exit 3; }
jq empty "$CONFIG" 2>/dev/null || { echo "erro: config.json invalido ($CONFIG)" >&2; exit 3; }

MODEL=$(jq -r '.model' "$CONFIG")
ENDPOINT=$(jq -r '.endpoint // "http://localhost:11434/api/chat"' "$CONFIG")
DEFAULT_ROUTE=$(jq -r '.default_route // "glm"' "$CONFIG")

# Rotas no formato do Plano (uma linha por rota: {name, description}).
ROUTES=$(jq -c '.routes[] | {name, description}' "$CONFIG")
# Opcoes de geracao e schema restrito (enum com os nomes das rotas do config).
OPTS=$(jq -c '.options // {temperature:0, num_predict:32}' "$CONFIG")
SCHEMA=$(jq -c '{type:"object",properties:{route:{type:"array",items:{type:"string",enum:[.routes[].name]}}},required:["route"]}' "$CONFIG")

# Conversa no formato esperado pelo Plano.
CONV=$(jq -n --arg p "$PROMPT" '[{role:"user",content:$p}]')

# Prompt de orquestracao do Plano (formato nativo do model card). %s = routes, conversation.
read -r -d '' TMPL <<'EOF' || true
You are a helpful assistant that selects the most suitable routes based on user intent.
You are provided with a list of available routes enclosed within <routes></routes> XML tags:
<routes>
%s
</routes>

You are also given the conversation context enclosed within <conversation></conversation> XML tags:
<conversation>
%s
</conversation>

## Instructions
1. Analyze the latest user intent from the conversation.
2. Compare it against the available routes to find which routes can help fulfill the request.
3. Respond only with the exact route names from <routes>.
4. If no routes can help or the intent is already fulfilled, return an empty list.

## Response Format
Return your answer strictly in JSON as follows:
{"route": ["route_name_1", "route_name_2", "..."]}
If no routes are needed, return an empty list for route.
EOF
PLANO_PROMPT=$(printf "$TMPL" "$ROUTES" "$CONV")

# Chama o modelo. think:false (o Qwen3 poe a resposta em thinking se ligado).
BODY=$(jq -n --arg m "$MODEL" --arg c "$PLANO_PROMPT" --argjson schema "$SCHEMA" --argjson opts "$OPTS" \
  '{model:$m, messages:[{role:"user",content:$c}], stream:false, format:$schema, think:false, options:$opts}')
RESP=$(curl -s "$ENDPOINT" -d "$BODY")

# route[] pode trazer mais de uma (multi-intent); usamos a primeira.
ROUTE=$(echo "$RESP" | jq -r '.message.content | fromjson | .route[0] // empty' 2>/dev/null || true)
EXTRA=$(echo "$RESP" | jq -r '.message.content | fromjson | .route[1:] | join(", ")' 2>/dev/null || true)

if [[ -z "$ROUTE" ]]; then
  echo "aviso: modelo devolveu lista vazia; usando fallback '$DEFAULT_ROUTE'" >&2
  ROUTE="$DEFAULT_ROUTE"
fi

# Mapeia rota -> alias da CLI (campo 'cli' no config).
CLI=$(jq -r --arg r "$ROUTE" '.routes[] | select(.name==$r) | .cli' "$CONFIG")
[[ -z "$CLI" ]] && { echo "rota invalida: '$ROUTE' (resposta: $RESP)" >&2; exit 2; }

echo "rota:     $ROUTE  ->  $CLI"
[[ -n "$EXTRA" ]] && echo "tambem:   $EXTRA"

if $RUN; then
  echo "abrindo $CLI no Ghostty..."
  open -na Ghostty --args -e zsh -ic "${CLI} $(printf '%q' "$PROMPT")"
else
  echo "(dry-run; use --run para abrir a CLI)"
fi
