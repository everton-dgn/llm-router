#!/usr/bin/env bash
# Roteador local de modelos: um classificador local (definido em config.json; por
# padrao o Plano-Orchestrator-4B rodando no Ollama) decide qual modelo deve atender
# cada prompt e abre a CLI interativa dele numa janela do Ghostty.
#
# Toda a config (modelo, endpoint, rotas, criterios, mapeamento CLI, parametros)
# vive no config.json ao lado deste script. Editar rotas nao exige tocar no codigo.
#
# Uso:
#   route "prompt"          # dry-run: so mostra a rota escolhida
#   route --run "prompt"    # decide E abre a CLI interativa no Ghostty
#   route --auto "prompt"   # executa, verifica e escala sem interface grafica
#
# Requer: modelo do config baixado no Ollama (ex.):
#   ollama pull hf.co/mradermacher/Plano-Orchestrator-4B-GGUF:Q4_K_M
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$SCRIPT_DIR/config.json"
[[ -f "$CONFIG" ]] || { echo "erro: config nao encontrado em $CONFIG" >&2; exit 3; }
jq empty "$CONFIG" 2>/dev/null || { echo "erro: config.json invalido ($CONFIG)" >&2; exit 3; }

show_help() {
  local command_name
  command_name="$(basename "$0")"

  cat <<EOF
Uso: $command_name [--run | --auto [--verifier nome]] "prompt"
     $command_name help
     $command_name --help

Modos:
  padrão      Classifica o prompt, mostra a rota escolhida e encerra.
  --run       Classifica e abre a CLI interativa em uma janela do Ghostty.
  --auto      Executa a tarefa sem interface, verifica e escala se necessário.
  --verifier  Sobrescreve o verificador do modo --auto.

Rotas:
EOF
  jq -r '
    .routing[] as $routing
    | .routes[]
    | select(.name == $routing.route)
    | "  \($routing.route): \(.display_name)\n    \($routing.help)"
  ' "$CONFIG"
  cat <<EOF

Cascade automático:
EOF
  jq -r '.auto.ladders | to_entries[] | "  \(.key): \(.value | join(" -> "))"' "$CONFIG"
  cat <<EOF
  Cada rota pode repetir uma vez antes de escalar.

Verificadores:
EOF
  jq -r '.auto.verifiers | keys[] | "  \(.)"' "$CONFIG"
  cat <<EOF

Exemplos:
  $command_name "quantos arquivos tem este projeto?"
  $command_name --run "adicione validação ao formulário"
  $command_name --auto "corrija a race condition e valide os testes"
  $command_name --auto --verifier null "gere cinco nomes para o projeto"

Requisitos:
  Ollama e o modelo classificador configurado; jq e curl no PATH.
  --run também requer Ghostty e os aliases cld, cdx, m3 e glm.
  --auto também requer uv, trash e as CLIs dos workers autenticadas.
EOF
}

MODE="dry-run"
VERIFIER=""

case "${1:-}" in
  -h|--help|help)
    show_help
    exit 0
    ;;
  --run)
    MODE="run"
    shift
    ;;
  --auto)
    MODE="auto"
    shift
    if [[ "${1:-}" == "--verifier" ]]; then
      [[ -n "${2:-}" ]] || { echo "erro: --verifier exige um nome" >&2; exit 1; }
      VERIFIER="$2"
      shift 2
    fi
    ;;
esac

PROMPT="${1:-}"
[[ -z "$PROMPT" ]] && {
  echo "uso: $(basename "$0") [--run | --auto [--verifier nome]] \"prompt\""
  echo "use '$(basename "$0") --help' para ver todos os modos e rotas"
  exit 1
}

if [[ "$MODE" == "auto" ]]; then
  command -v uv >/dev/null 2>&1 || { echo "erro: uv nao encontrado no PATH" >&2; exit 3; }
  command -v trash >/dev/null 2>&1 || { echo "erro: trash nao encontrado no PATH" >&2; exit 3; }
fi

MODEL=$(jq -r '.model' "$CONFIG")
ENDPOINT=$(jq -r '.endpoint // "http://localhost:11434/api/chat"' "$CONFIG")

# Intencoes no formato do Plano (uma linha por preferencia: {name, description}).
ROUTES=$(jq -c '.routing[] | {name:.intent, description}' "$CONFIG")
# Opcoes de geracao e schema restrito a exatamente uma intencao configurada.
OPTS=$(jq -c '.options // {temperature:0, num_predict:32}' "$CONFIG")
SCHEMA=$(jq -c '{type:"object",properties:{route:{type:"array",minItems:1,maxItems:1,items:{type:"string",enum:[.routing[].intent]}}},required:["route"],additionalProperties:false}' "$CONFIG")

# Conversa no formato esperado pelo Plano.
CONV=$(jq -n --arg p "$PROMPT" '[{role:"user",content:$p}]')

# Prompt de orquestracao do Plano (formato nativo do model card). %s = routes, conversation.
read -r -d '' TMPL <<'EOF' || true
You are a routing classifier. Select exactly one route for every user request.
<routes>
%s
</routes>
<conversation>
%s
</conversation>
Match the latest user intent to the single most specific route name and description.
For mixed intents, route by the requested final deliverable. Planning followed by implementation is implementation, not planning-only. Code review and audit always use the review route.
Always return one route. Never return an empty list.
Return strict JSON only: {"route":["route_name"]}
EOF
# TMPL é um formato controlado com dois placeholders %s.
# shellcheck disable=SC2059
PLANO_PROMPT=$(printf "$TMPL" "$ROUTES" "$CONV")

# Chama o modelo. think:false (o Qwen3 poe a resposta em thinking se ligado).
BODY=$(jq -n --arg m "$MODEL" --arg c "$PLANO_PROMPT" --argjson schema "$SCHEMA" --argjson opts "$OPTS" \
  '{model:$m, messages:[{role:"user",content:$c}], stream:false, format:$schema, think:false, options:$opts}')
RESP=$(curl -s "$ENDPOINT" -d "$BODY")

INTENT=$(echo "$RESP" | jq -r '.message.content | fromjson | .route[0] // empty' 2>/dev/null || true)
[[ -n "$INTENT" ]] || { echo "erro: classificador não devolveu uma rota válida" >&2; exit 2; }

# Mapeia a intenção semântica para o executor real.
ROUTE=$(jq -r --arg intent "$INTENT" '.routing[] | select(.intent == $intent) | .route' "$CONFIG")
[[ -n "$ROUTE" ]] || { echo "erro: intenção desconhecida: '$INTENT'" >&2; exit 2; }

# Mapeia rota -> alias da CLI (campo 'cli' no config).
CLI=$(jq -r --arg r "$ROUTE" '.routes[] | select(.name==$r) | .cli' "$CONFIG")
[[ -z "$CLI" ]] && { echo "rota invalida: '$ROUTE' (resposta: $RESP)" >&2; exit 2; }

echo "rota:     $ROUTE  ->  $CLI"

if [[ "$MODE" == "run" ]]; then
  echo "abrindo $CLI no Ghostty..."
  open -na Ghostty --args -e zsh -ic "${CLI} $(printf '%q' "$PROMPT")"
elif [[ "$MODE" == "auto" ]]; then
  AUTO_ARGS=(
    --config "$CONFIG"
    --route "$ROUTE"
    --prompt "$PROMPT"
    --cwd "$PWD"
  )
  [[ -n "$VERIFIER" ]] && AUTO_ARGS+=(--verifier "$VERIFIER")
  exec uv run --no-project --no-python-downloads python "$SCRIPT_DIR/auto_runner.py" "${AUTO_ARGS[@]}"
else
  echo "(dry-run; use --run para abrir a CLI)"
fi
