#!/usr/bin/env bash
# Roteador local de modelos: um classificador local definido em config.json
# decide qual agente configurado no OpenCode deve atender cada prompt.
#
# Toda a configuração de classificação vive no config.json ao lado deste script.
# Editar rotas não exige tocar no código.
#
# Uso:
#   route "prompt"                    # saída humana
#   route --classify --json "prompt"  # contrato estável para integrações
#
# Requer o modelo do config baixado no Ollama, por exemplo:
#   ollama pull hf.co/mradermacher/Plano-Orchestrator-4B-GGUF:Q4_K_M
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$SCRIPT_DIR/config.json"
[[ -f "$CONFIG" ]] || { echo "erro: config nao encontrado em $CONFIG" >&2; exit 3; }
jq empty "$CONFIG" 2>/dev/null || { echo "erro: config.json invalido ($CONFIG)" >&2; exit 3; }

show_help() {
  local command_name
  command_name="$(basename "$0")"

  cat <<EOF
Uso: $command_name "prompt"
     $command_name --classify --json "prompt"
     $command_name help
     $command_name --help

Saídas:
  padrão               Classifica e mostra a rota em formato humano.
  --classify --json     Retorna o contrato JSON versionado para integrações.

Rotas:
EOF
  jq -r '
    .routing[] as $routing
    | .routes[]
    | select(.name == $routing.route)
    | "  \($routing.route): \(.display_name)\n    \($routing.help)"
  ' "$CONFIG"
  cat <<EOF

Exemplos:
  $command_name "quantos arquivos tem este projeto?"
  $command_name --classify --json "planeje uma migração sem downtime"

Requisitos:
  Ollama e o modelo classificador configurado; jq e curl no PATH.
EOF
}

CLASSIFY=false
JSON_OUTPUT=false
PROMPT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|help)
      show_help
      exit 0
      ;;
    --classify)
      CLASSIFY=true
      shift
      ;;
    --json)
      JSON_OUTPUT=true
      shift
      ;;
    --)
      shift
      [[ $# -eq 1 && -z "$PROMPT" ]] || {
        echo "erro: -- exige exatamente um prompt depois dele" >&2
        exit 1
      }
      PROMPT=$1
      shift
      ;;
    --*)
      echo "erro: opção desconhecida: $1" >&2
      exit 1
      ;;
    *)
      [[ -z "$PROMPT" ]] || { echo "erro: informe o prompt como um único argumento" >&2; exit 1; }
      PROMPT=$1
      shift
      ;;
  esac
done

if [[ "$JSON_OUTPUT" == true && "$CLASSIFY" != true ]]; then
  echo "erro: --json exige --classify" >&2
  exit 1
fi

[[ -n "$PROMPT" ]] || {
  echo "uso: $(basename "$0") [--classify --json] \"prompt\"" >&2
  echo "use '$(basename "$0") --help' para ver o contrato e as rotas" >&2
  exit 1
}

MODEL=$(jq -r '.model' "$CONFIG")
ENDPOINT=$(jq -r '.endpoint // "http://localhost:11434/api/chat"' "$CONFIG")

# Intencoes no formato do Plano (uma linha por preferencia: {name, description}).
ROUTES=$(jq -c '.routing[] | {name:.intent, description}' "$CONFIG")
# Opcoes de geracao e schema restrito a exatamente uma intencao configurada.
OPTS=$(jq -c '.options // {temperature:0, num_predict:32}' "$CONFIG")
SCHEMA=$(jq -c '{type:"object",properties:{route:{type:"array",minItems:1,maxItems:1,items:{type:"string",enum:[.routing[].intent]}}},required:["route"],additionalProperties:false}' "$CONFIG")

# Conversa no formato esperado pelo Plano.
CONV=$(jq -n --arg p "$PROMPT" '[{role:"user",content:$p}]')

# Prompt de orquestracao do Plano (formato nativo do model card). %s = routes, conversation.
read -r -d '' TMPL <<'EOF' || true
You are a routing classifier. Select exactly one route for every user request.
<routes>
%s
</routes>
<conversation>
%s
</conversation>
Match the latest user intent to the single most specific route name and description.
For mixed intents, route by the requested final deliverable. Planning followed by implementation is implementation, not planning-only. Code review and audit always use the review route.
Task length does not determine difficulty. Treat every "always", "every", "only", and "never" boundary in the route descriptions as absolute.
A literal task copies, counts, locates, extracts, or mechanically formats existing data. Summarizing, naming, correcting, documenting, translating, brainstorming, and writing prose are not literal tasks.
Simple brainstorming and simple documentation, including a CLI reference written from supplied flags, belong to the general simple-or-intermediate route. For a short numbered set of ideas for one known audience, without evaluation, product strategy, or research, select translation_simple_brainstorm_docs_or_intermediate_work exactly. The word "brainstorm" alone never makes a request complex. These tasks are neither literal nor complex creative work.
A brief pros-and-cons discussion without architecture, product strategy, or high-stakes planning is simple open discussion. A troubleshooting guide for one known flow is intermediate documentation. Diagnosing a routine HTTP 500 in one controller is ordinary debugging. All three use the general simple-or-intermediate route.
Engineering technical writing means a standalone audience-facing artifact such as a concept explanation, design memo, incident report, or technically precise social post. Explaining an existing code path or module from inspected code stays in general work unless review, audit, or another hard signal is present.
Concurrency primitives, lock-free structures, stress or concurrency tests, compiler transformations, races, and deadlocks are hard engineering regardless of prompt length. A request only to plan remediation before implementation stays in complex planning unless it asks for a threat model or security analysis.
Research-backed content adapted into a multi-platform social campaign is hard creative work, not simple social copy.
Threat modeling and security analysis always use the review and hard-engineering route, even when the prompt also mentions planning or architecture.
Intermediate social content that requires technical precision uses the engineering technical-writing route. General intermediate social copy stays in general work; hard social strategy stays in complex creative work.
Always return one route. Never return an empty list.
Return strict JSON only: {"route":["route_name"]}
EOF
# TMPL é um formato controlado com dois placeholders %s.
# shellcheck disable=SC2059
PLANO_PROMPT=$(printf "$TMPL" "$ROUTES" "$CONV")

# Chama o modelo. think:false evita que a resposta seja enviada como raciocínio.
BODY=$(jq -n --arg m "$MODEL" --arg c "$PLANO_PROMPT" --argjson schema "$SCHEMA" --argjson opts "$OPTS" \
  '{model:$m, messages:[{role:"user",content:$c}], stream:false, format:$schema, think:false, options:$opts}')

classification_error() {
  local code=$1
  local message=$2
  if [[ "$JSON_OUTPUT" == true ]]; then
    jq -cn --arg code "$code" --arg message "$message" \
      '{schema_version:1,error:{code:$code,message:$message}}' >&2
  else
    printf 'erro: %s\n' "$message" >&2
  fi
  exit 2
}

if ! RESP=$(curl -sS --connect-timeout 5 --max-time 120 -H 'Content-Type: application/json' "$ENDPOINT" -d "$BODY"); then
  classification_error "classifier_unavailable" "não foi possível consultar o classificador"
fi

INTENT=$(echo "$RESP" | jq -r '.message.content | fromjson | .route[0] // empty' 2>/dev/null || true)
[[ -n "$INTENT" ]] || classification_error \
  "invalid_classifier_response" \
  "classificador não devolveu uma rota válida"

# Mapeia a intenção semântica para o executor real.
ROUTE=$(jq -r --arg intent "$INTENT" '.routing[] | select(.intent == $intent) | .route' "$CONFIG")
[[ -n "$ROUTE" ]] || classification_error \
  "unknown_intent" \
  "intenção desconhecida: '$INTENT'"

DISPLAY_NAME=$(jq -r --arg route "$ROUTE" \
  '.routes[] | select(.name == $route) | .display_name // empty' "$CONFIG")
[[ -n "$DISPLAY_NAME" ]] || classification_error \
  "unknown_route" \
  "rota desconhecida: '$ROUTE'"

if [[ "$JSON_OUTPUT" == true ]]; then
  jq -cn \
    --arg intent "$INTENT" \
    --arg route "$ROUTE" \
    '{schema_version:1,intent:$intent,route:$route}'
else
  printf 'rota:     %s  ->  %s\n' "$ROUTE" "$DISPLAY_NAME"
fi
